# ---- Firebase (client) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firebase Admin (server) ----
# Paste the service-account JSON as a single line, or base64 of it.
FIREBASE_SERVICE_ACCOUNT=

# ---- Admin portal ----
# Only this email (plus any uid given the `admin` custom claim via `npm run set-admin`) can open /admin.
ADMIN_EMAIL=

# ---- Cloudflare R2 (private storage for KYC documents and deposit proofs) ----
# Create a bucket in the Cloudflare dashboard -> R2, then an API token with Object Read & Write.
# Add a CORS rule on the bucket allowing PUT from your site origin (see docs/SETUP.md).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=plutovest-private

# ---- Scheduled settlement (optional safety net; earnings also settle when users open the app) ----
CRON_SECRET=

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=PlutoVest
